# AI can be disabled, proxied to your existing AI web app, or connected directly to OpenAI.
ENABLE_AI=true
AI_PROVIDER=external

# Direct OpenAI provider
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# External AI provider: proxy to an already-deployed AI web app.
EXTERNAL_AI_BASE_URL=
EXTERNAL_AI_CHAT_ENDPOINT=/chat-web
EXTERNAL_AI_TIMEOUT_SECONDS=45

# MVP budget controls
AI_DAILY_LIMIT=20
AI_CACHE_ENABLED=true

# Open Meeting Room (single FastAPI worker, SQLite persistence)
# Default database is backend/data/meetings.sqlite3; override with an absolute path.
# MEETINGS_DB_PATH=/absolute/path/to/meetings.sqlite3
MEETINGS_MEDIA_PROVIDER=disabled
# To enable self-hosted audio, set provider to livekit and configure all three:
LIVEKIT_URL=http://127.0.0.1:7880
LIVEKIT_PUBLIC_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Comma-separated additional web origins for split frontend/backend deployments.
MEETINGS_ALLOWED_ORIGINS=
